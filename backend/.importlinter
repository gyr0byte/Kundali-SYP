[importlinter]
root_packages =
    app

[importlinter:contract:calc-independence]
name = Calculation engine must not import from AI layer
type = forbidden
source_modules =
    app.calc
forbidden_modules =
    app.ai

[importlinter:contract:calc-no-framework]
name = Calculation engine must not import from API, DB, or Core
type = forbidden
source_modules =
    app.calc
forbidden_modules =
    app.api
    app.db
    app.core
