# Kundali — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Hosted PostgreSQL connection string (Neon or Supabase)
# Must include sslmode=require
DATABASE_URL=

# Auth
JWT_SECRET=
ENCRYPTION_KEY=

# LLM provider configuration
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
OLLAMA_BASE_URL=
