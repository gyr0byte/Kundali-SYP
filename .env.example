# Kundali — Environment Variables
# Set these privately in the PowerShell process environment. This file is a template only.

# Hosted PostgreSQL connection string (Neon or Supabase)
# Use a direct endpoint. Omit TLS parameters or use sslmode=verify-full&channel_binding=require.
DATABASE_URL=
KUNDALI_DB_CA_FILE=
KUNDALI_DB_MIGRATION_TARGET=

# Opt-in disposable PostgreSQL integration only
KUNDALI_TEST_DATABASE_URL=
KUNDALI_TEST_DATABASE_TARGET=
KUNDALI_RUN_POSTGRES_TESTS=0

# Auth
JWT_SECRET=
ENCRYPTION_KEY=

# LLM provider configuration
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
OLLAMA_BASE_URL=
