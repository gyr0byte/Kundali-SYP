# Auto detect text files and perform LF normalization
* text=auto

# Python
*.py text diff=python

# Web
*.js text
*.jsx text
*.ts text
*.tsx text
*.css text
*.html text
*.json text
*.md text

# The synthetic generation pilot verifies the fixture's raw SHA-256.
backend/tests/fixtures/synthetic-generation-v1.json text eol=lf

# Binary
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
